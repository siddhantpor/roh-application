APP_SECRET_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Verified emails granted admin access ONLY when first linked to an account.
# After that, accounts.is_admin is authoritative. Use the set-admin CLI to change it.
ADMIN_EMAILS=

DATABASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set true when serving over HTTPS; false permits local HTTP development.
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=0
